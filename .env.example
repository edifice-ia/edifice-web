PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=https://www.edificeia.com/api/auth/pinterest/callback
PINTEREST_ENVIRONMENT=production
PINTEREST_ACCESS_LEVEL=trial
OAUTH_STATE_SECRET=
RENDERER_BASE_URL=
RENDERER_SHARED_SECRET=

# Requis par les deux routes cron internes du depot (verifie via
# Authorization: Bearer <secret> ou le header x-cron-secret) :
# - app/api/internal/cron/process-scheduled-publications
# - app/api/internal/cron/personal-daily-brief
CRON_SECRET=

# Garmin Connect (DEC-006 : acces Developer Program en cours de validation,
# ne pas renseigner tant que l'approbation n'est pas confirmee manuellement).
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_REDIRECT_URI=

# Client OAuth Google "Edifice IA" (projet Google Cloud "Edifice IA YouTube
# Publisher"), partage par YouTube et Google Calendar : une seule paire de
# credentials pour un seul client OAuth, scopes distincts par service.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# YouTube utilise un redirect_uri statique (un seul domaine enregistre).
YOUTUBE_REDIRECT_URI=

# Google Calendar n'a pas de REDIRECT_URI statique : deux domaines sont
# enregistres cote Google Cloud (edifice-web.vercel.app et www.edificeia.com)
# et l'URI de redirection est resolue dynamiquement selon le domaine de la
# requete entrante (voir lib/server/oauth/calendar-redirect.ts).
